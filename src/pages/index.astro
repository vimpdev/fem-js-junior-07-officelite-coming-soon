---
import Header from "../components/Header.astro";
import Button from "../components/Button.astro";
import PricingCard from "../components/PricingCard.astro";
import Countdown from "../components/Countdown.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const plans = [
	{
		name: "Basic",
		price: "Free",
		description: "Up to 5 users for free",
		features: [
			"Basic document collaboration",
			"2 GB storage",
			"Great security and support",
		],
	},
	{
		name: "Pro",
		price: "$9.99",
		description: "Per user, billed monthly",
		features: [
			"All essential integrations",
			"50 GB storage",
			"More control and insights",
		],
	},
	{
		name: "Ultimate",
		price: "$19.99",
		description: "Per user, billed monthly",
		features: ["Robust work management", "100 GB storage", "VIP support"],
	},
];
---

<BaseLayout>
	<Header />

	<main>
		<section class="hero">
			<div class="hero__inner container">
				<div class="hero__content">
					<h1 class="hero__title">
						A simple solution to complex tasks is coming soon
					</h1>
					<p class="hero__description">
						Say goodbye to inefficient juggling of multiple apps, teams, and
						projects. Officelite is the new collaboration platform built with an
						intuitive interface to improve productivity.
					</p>

					<Button href="/sign-up" label="Get Started" />
				</div>

				<div class="hero__media">
					<img src="/images/illustrations/charts.svg" alt="" />
				</div>
			</div>
		</section>

		<section class="pricing">
			<h2 class="visually-hidden">Pricing plans</h2>

			<ul class="pricing__list">
				{plans.map((plan) => <PricingCard {...plan} />)}
			</ul>
		</section>

		<section class="countdown">
			<div class="countdown__inner container">
				<Countdown />

				<Button href="/sign-up" label="Get Started" />
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<small
			>Challenge by <a
				href="https://www.frontendmentor.io/challenges"
				target="_blank"
				rel="noopener noreferrer">Frontend Mentor</a
			> &ndash; Coded by <a
				href="https://www.frontendmentor.io/profile/vimpdev"
				target="_blank"
				rel="noopener noreferrer">VIMP</a
			></small
		>
	</footer>
</BaseLayout>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow-x: clip;

		margin-block-start: var(--space-1000);

		&::before {
			content: "";
			position: absolute;
			inset-inline-start: 50%;
			inset-block-start: 0;
			translate: -50% -65%;
			inline-size: 28.75rem;
			block-size: 28.75rem;
			background: url("/images/patterns/bg-header.svg") center / contain;
			pointer-events: none;
			z-index: -1;
		}
	}

	.hero__inner {
		display: flex;
		flex-direction: column-reverse;
		gap: 1rem;
	}

	.hero__content {
		display: flex;
		flex-direction: column;
		gap: var(--space-300);
		text-align: center;
	}

	.hero__title {
		font-size: var(--font-size-400);
		line-height: 1.2;
	}

	.hero__description {
		padding-inline: 0.1rem;
		font-size: var(--font-size-100);
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.hero__media {
		inline-size: 13.8rem;
		align-self: center;
	}
</style>
